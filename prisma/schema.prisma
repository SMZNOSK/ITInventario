// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ===================== Catálogos / Inventario =====================

model Type {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands Brand[]
  assets Asset[]
  models Model[]
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  typeId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type   Type?   @relation(fields: [typeId], references: [id])
  assets Asset[]
  models Model[]
}

model Model {
  id             Int      @id @default(autoincrement())
  name           String
  typeId         Int
  brandId        Int
  isDiscontinued Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assets Asset[]
  brand  Brand   @relation(fields: [brandId], references: [id])
  type   Type    @relation(fields: [typeId], references: [id])

  @@unique([name, typeId, brandId])
}

/// ===================== Catálogos técnicos (SO, CPU, RAM, Disco, Almacenamiento) =====================

model OperatingSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique // p.ej. "Windows 11 Pro"
  vendor    String?  // p.ej. "Microsoft"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Processor {
  id           Int      @id @default(autoincrement())
  name         String   @unique // p.ej. "Intel Core i5-10400"
  vendor       String?  // Intel / AMD / Apple / etc
  cores        Int?
  threads      Int?
  baseClockGhz Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RamModule {
  id        Int      @id @default(autoincrement())
  name      String
  vendor    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiskType {
  id        Int      @id @default(autoincrement())
  name      String
  vendor    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, vendor])
}

model StorageCapacity {
  id        Int      @id @default(autoincrement())
  name      String   @unique // "256 GB", "512 GB", "1 TB"…
  vendor    String?  // opcional, por si quieres marca
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ===================== Catálogos lógicos (Plataformas / Departamentos) =====================

model Platform {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments       Assignment[]
  loans             Loan[]
  manualAssignments ManualAssignment[]
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
}

model Hotel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
  users  UserHotel[]

  // ✅ Backref correcto para Loan.hotel (misma relation name)
  loans Loan[] @relation("LoanHotel")

  // ✅ Relaciones para transferencias
  transfersAsOrigin AssetTransfer[] @relation("TransferOrigin")
  transfersAsDest   AssetTransfer[] @relation("TransferDest")

  // ✅ Relación para bajas
  disposals Disposal[] @relation("HotelDisposals")
}

model Asset {
  id             Int             @id @default(autoincrement())
  serial         String          @unique
  typeId         Int
  brandId        Int
  modelId        Int
  currentHotelId Int?
  status         EquipmentStatus @default(ALTA)

  overThreeYears Boolean @default(false)

  invoiceNumber String?
  invoiceDate   DateTime?
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id])
  currentHotel      Hotel?             @relation(fields: [currentHotelId], references: [id])
  model             Model              @relation(fields: [modelId], references: [id])
  type              Type               @relation(fields: [typeId], references: [id])
  assignments       Assignment[]       @relation("AssetAssignments")
  manualAssignments ManualAssignment[] @relation("AssetManualAssignments")
  disposals         Disposal[]         @relation("AssetDisposals")

  // ✅ Relación para transferencias
  transfers AssetTransfer[]

  @@index([status])
  @@index([currentHotelId])
  @@map("Equipment")
}

/// ===================== Assignment =====================

enum AssignmentStatus {
  ASIGNADO
  DEVUELTO
}

model Assignment {
  id               Int              @id @default(autoincrement())
  assetId          Int
  collaboratorId   String
  collaboratorName String?
  status           AssignmentStatus @default(ASIGNADO)
  assignedAt       DateTime         @default(now())
  returnedAt       DateTime?
  createdById      Int?

  /// Nombre de equipo estable por colaborador (CPU/LAP)
  teamName String?

  /// Catálogo Departamento
  departmentId Int?
  /// Catálogo Plataforma
  platformId   Int?

  asset       Asset @relation("AssetAssignments", fields: [assetId], references: [id])
  createdBy   User? @relation("UserAssignments", fields: [createdById], references: [id])
  collaborator Collaborator? @relation("CollaboratorAssignments", fields: [collaboratorId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])
  platform   Platform?   @relation(fields: [platformId], references: [id])

  @@index([assetId])
  @@index([collaboratorId])
  @@index([departmentId])
  @@index([platformId])
}

/// ===================== Asignaciones manuales (sin número de colaborador) =====================

model ManualAssignment {
  id                Int     @id @default(autoincrement())
  assetId           Int
  collaboratorName  String
  collaboratorEmail String?
  direction         String?
  department        String?
  hotel             String?
  description       String?

  /// Nombre de equipo (solo si aplica, CPU/LAPTOP)
  teamName String?

  /// Plataforma (solo si aplica, CPU/LAPTOP)
  platformId Int?

  status      AssignmentStatus @default(ASIGNADO)
  assignedAt  DateTime         @default(now())
  returnedAt  DateTime?
  createdById Int?

  asset     Asset     @relation("AssetManualAssignments", fields: [assetId], references: [id])
  platform  Platform? @relation(fields: [platformId], references: [id])
  createdBy User?     @relation("UserManualAssignments", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([platformId])
  @@index([status])
}

/// ===================== LOAN / PRÉSTAMOS =====================

model Loan {
  id                Int     @id @default(autoincrement())
  collaboratorId    String
  collaboratorName  String?
  collaboratorEmail String?
  departmentName    String?
  address           String?

  // ✅ Equipo prestado (ID/serial/etiqueta inventario)
  // Ej: "LAP-000001 · POIUHGVBN8"
  teamName          String

  // ✅ Nombre de equipo (solo CPU/LAP)
  // Ej: "PFUNDACIONZM2"
  deviceName        String?

  hotelId   Int?
  hotel     Hotel?  @relation("LoanHotel", fields: [hotelId], references: [id])

  hotelName String? // opcional (snapshot)

  platformId Int?
  platform   Platform? @relation(fields: [platformId], references: [id])

  comments  String?
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collaboratorId])
  @@index([hotelId])
  @@index([platformId])
  @@index([startDate])
}

/// ===================== Disposal / BAJAS  =====================

model Disposal {
  id            Int       @id @default(autoincrement())
  assetId       Int
  hotelId       Int?      // Hotel del equipo al momento de la baja
  reason        String
  notes         String?
  evidenceUrl   String?   // Legacy: single URL (para compatibilidad)
  disposedAt    DateTime  @default(now())
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  restoredAt    DateTime? // Fecha de restauración a ALTA
  restoredById  Int?      // Usuario que restauró

  asset       Asset    @relation("AssetDisposals", fields: [assetId], references: [id])
  hotel       Hotel?   @relation("HotelDisposals", fields: [hotelId], references: [id])
  createdBy   User?    @relation("UserDisposals", fields: [createdById], references: [id])
  restoredBy  User?    @relation("UserRestoredDisposals", fields: [restoredById], references: [id])
  evidences   DisposalEvidence[]

  @@index([assetId])
  @@index([hotelId])
}

model DisposalEvidence {
  id          Int      @id @default(autoincrement())
  disposalId  Int
  url         String
  filename    String?
  mime        String?
  size        Int?
  createdAt   DateTime @default(now())

  disposal    Disposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)

  @@index([disposalId])
}

/// ===================== Autenticación / Roles =====================

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  name         String
  passwordHash String
  status       UserStatus @default(ALTA)
  role         Role
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hotels                   UserHotel[]
  createdAssignments       Assignment[]       @relation("UserAssignments")
  createdManualAssignments ManualAssignment[] @relation("UserManualAssignments")
  createdDisposals         Disposal[]         @relation("UserDisposals")
  restoredDisposals        Disposal[]         @relation("UserRestoredDisposals")
}

model Collaborator {
  id       String  @id
  name     String
  phone    String?
  email    String?
  jobTitle String?

  teamName String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[] @relation("CollaboratorAssignments")
}

model UserHotel {
  id      Int @id @default(autoincrement())
  userId  Int
  hotelId Int

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
}

model Provider {
  id   Int    @id @default(autoincrement())
  name String @unique
}

/// ===================== Tablas legacy (PeopleSoft-like) =====================

model marca {
  id_marca     Int    @id @default(autoincrement())
  nombre_marca String @unique @db.VarChar(120)

  modelo modelo[]
}

model modelo {
  id_modelo      Int    @id @default(autoincrement())
  nombre_modelo  String @unique @db.VarChar(150)
  estado         String @default("ALTA") @db.VarChar(10)
  id_tipo_equipo Int
  id_marca       Int

  marca       marca       @relation(fields: [id_marca], references: [id_marca], onUpdate: NoAction)
  tipo_equipo tipo_equipo @relation(fields: [id_tipo_equipo], references: [id_tipo_equipo], onUpdate: NoAction)

  @@index([estado], map: "idx_modelo_estado")
  @@index([id_marca], map: "idx_modelo_marca")
  @@index([id_tipo_equipo], map: "idx_modelo_tipo")
}

model proveedor {
  id_proveedor     Int    @id @default(autoincrement())
  nombre_proveedor String @unique @db.VarChar(150)
}

model tipo_equipo {
  id_tipo_equipo Int    @id @default(autoincrement())
  nombre_tipo    String @unique @db.VarChar(120)

  modelo modelo[]
}

/// ===================== Enums =====================

enum EquipmentStatus {
  ALTA
  ASIGNADO
  TRANSFERENCIA_PENDIENTE
  BAJA
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum UserStatus {
  ALTA
  INACTIVO
}

enum Role {
  ADMIN
  ALMACEN
  INGENIERO
}

/// ===================== Asset Transfers =====================
model AssetTransfer {
  id              Int            @id @default(autoincrement())
  assetId         Int
  originHotelId   Int
  destHotelId     Int
  status          TransferStatus @default(PENDING)

  createdByUserId   Int
  acceptedByUserId  Int?
  canceledByUserId  Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  canceledAt  DateTime?

  asset       Asset @relation(fields: [assetId], references: [id])
  originHotel Hotel @relation("TransferOrigin", fields: [originHotelId], references: [id])
  destHotel   Hotel @relation("TransferDest", fields: [destHotelId], references: [id])

  @@index([assetId, status])
  @@index([destHotelId, status])
  @@index([originHotelId, status])
}
